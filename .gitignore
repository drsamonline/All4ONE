# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Runtime logs (keep the folder, ignore contents)
logs/*
!logs/.gitkeep

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Secrets / local config overrides
.env
*.local.json
