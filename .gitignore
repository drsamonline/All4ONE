# Bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Build output (never commit release artifacts)
build/
dist/
*.egg-info/

# Runtime data
logs/*
!logs/.gitkeep

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
