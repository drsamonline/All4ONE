# Python bytecode / caches
__pycache__/
*.py[cod]

# Runtime logs (ship the folder only, never its contents)
logs/*
!logs/.gitkeep

# Build & packaging artifacts
build/
dist/
*.egg-info/

# Plugin archives are generated by create_plugin_zips.py; keep them out of git
plugins/*.zip

# Test / lint caches
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.swp
