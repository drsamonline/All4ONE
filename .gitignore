# Bytecode / build caches (never commit; audit.py fails on tracked .pyc)
__pycache__/
*.py[cod]
*$py.class

# Runtime logs: directory ships only its .gitkeep placeholder
logs/*
!logs/.gitkeep

# PyInstaller / packaging output
build/
dist/
*.manifest

# Test / lint caches
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
